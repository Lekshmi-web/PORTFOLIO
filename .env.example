# Copy this file to .env.local and fill in from Supabase → Project Settings → API.
# Leave both empty to run the site with sample content only (no admin).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your live site URL (used for SEO, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show sample content where the database has nothing yet.
# Set to false in production once you've added your real content.
NEXT_PUBLIC_SHOW_SAMPLES=true
